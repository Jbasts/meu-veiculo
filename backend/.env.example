# Configuração do backend do Meu Veículo.
# Copie este arquivo para backend/.env e preencha DB_SENHA.
# O .env NUNCA vai para o Git e nunca é lido pelo frontend.

# Onde está o PostgreSQL
DB_HOST=localhost
DB_PORTA=5432

# Usuário próprio da aplicação (criado pelo "gerenciar.py criar-bancos").
# Não é o usuário "postgres": este não tem poderes de administrador do servidor.
DB_USUARIO=meu_veiculo_app
# Escolha uma senha nova só para a aplicação (não use a senha do postgres).
DB_SENHA=

# Bancos de desenvolvimento e de teste (precisam ser diferentes).
# Os testes APAGAM e recriam tudo no banco de teste.
DB_NOME=meu_veiculo
DB_NOME_TESTE=meu_veiculo_teste
# Banco de DEMONSTRAÇÃO (opcional): recebe os dados de exemplo do
# "gerenciar.py carregar-exemplo". Precisa terminar em _demo.
DB_NOME_DEMO=meu_veiculo_demo

# Administrador do PostgreSQL, usado só pelo "criar-bancos".
# A senha dele não fica aqui: o comando pergunta na hora.
PG_ADMIN_USUARIO=postgres

# Pasta "bin" do PostgreSQL (pg_dump). Deixe vazio para procurar sozinho.
PG_BIN=

# As fotos ficam no banco desde a migration 0013. Esta pasta é só a ANTIGA
# pasta de fotos, lida pela 0013 e pelo "gerenciar.py importar-fotos" para
# copiar as imagens para o banco. Deixe vazio para usar backend/storage.
PASTA_FOTOS=

# ---------------------------------------------------------------------------
# Etapa 2: contas e e-mail. Todos têm valor padrão; só mude se precisar.
# ---------------------------------------------------------------------------

# Endereço do frontend, usado nos links de "redefinir senha".
URL_FRONTEND=http://localhost:5173

# true = o cookie de sessão só trafega em HTTPS. Em http://localhost, deixe false.
COOKIE_SEGURO=false
# Validade da sessão (dias), do link de recuperação de senha (minutos) e do
# convite enviado pelo administrador para a pessoa definir a senha (dias).
SESSAO_DIAS=30
RECUPERACAO_MINUTOS=60
CONVITE_DIAS=7

# E-mail:
#   arquivo = em vez de enviar, grava cada mensagem em EMAIL_PASTA (.eml).
#             Abra o arquivo com o Outlook/Thunderbird ou no VS Code.
#   smtp    = envia de verdade pelo servidor SMTP abaixo.
EMAIL_MODO=arquivo
EMAIL_PASTA=
EMAIL_REMETENTE=Meu Veículo <nao-responda@meuveiculo.local>

# Só para EMAIL_MODO=smtp. SMTP_SEGURANCA: starttls (porta 587), ssl (465) ou nenhuma.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_SEGURANCA=starttls
