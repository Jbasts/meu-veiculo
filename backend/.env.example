# Configuração do backend do Meu Veículo.
# Copie este arquivo para backend/.env e preencha DB_SENHA.
# O .env NUNCA vai para o Git e nunca é lido pelo frontend.

# Onde está o PostgreSQL
DB_HOST=localhost
DB_PORTA=5432

# Usuário próprio da aplicação (criado pelo "gerenciar.py criar-bancos").
# Não é o usuário "postgres": este não tem poderes de administrador do servidor.
DB_USUARIO=meu_veiculo_app
# Escolha uma senha nova só para a aplicação (não use a senha do postgres).
DB_SENHA=

# Bancos de desenvolvimento e de teste (precisam ser diferentes).
# Os testes APAGAM e recriam tudo no banco de teste.
DB_NOME=meu_veiculo
DB_NOME_TESTE=meu_veiculo_teste

# Administrador do PostgreSQL, usado só pelo "criar-bancos".
# A senha dele não fica aqui: o comando pergunta na hora.
PG_ADMIN_USUARIO=postgres

# Pasta "bin" do PostgreSQL (pg_dump). Deixe vazio para procurar sozinho.
PG_BIN=
